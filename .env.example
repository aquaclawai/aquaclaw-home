# Secret token for ISR revalidation webhook (used by OpenClaw)
REVALIDATION_SECRET=change-me-to-a-secure-random-string

# Vercel Blob storage (run `vercel env pull` after creating a Blob store)
BLOB_READ_WRITE_TOKEN=

# API key for content publish endpoint (POST /api/content/publish)
CONTENT_API_KEY=change-me-to-a-secure-random-string

# Giscus comment system (get values from https://giscus.app after enabling GitHub Discussions)
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
